<Window x:Class="PulseMouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PulseMouse.App.Controls"
        Title="PulseMouse" Width="1220" Height="820" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource WinBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="#17FFFFFF" BorderThickness="1">
        <Grid x:Name="Root" ClipToBounds="True">
            <!-- ambient light -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.88,-0.12" GradientOrigin="0.88,-0.12" RadiusX="0.67" RadiusY="0.63">
                        <GradientStop Color="#1351E6CA" Offset="0"/>
                        <GradientStop Color="#0051E6CA" Offset="0.62"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="-0.05,1.1" GradientOrigin="-0.05,1.1" RadiusX="0.57" RadiusY="0.61">
                        <GradientStop Color="#0B75B7FF" Offset="0"/>
                        <GradientStop Color="#0075B7FF" Offset="0.6"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- ========== title bar ========== -->
                <Border Grid.Row="0" Background="#03FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBarMouseDown">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="最小化">
                                <Path Data="M1 6h10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                            </Button>
                            <Button Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="最大化 / 还原">
                                <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.2"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button Style="{StaticResource CaptionClose}" Click="CloseClick" ToolTip="隐藏到托盘">
                                <Path Data="M1.5 1.5l9 9M10.5 1.5l-9 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Grid Width="18" Height="18">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.8" RadiusY="0.8">
                                            <GradientStop Color="#9EFFEE" Offset="0"/>
                                            <GradientStop Color="#51E6CA" Offset="0.55"/>
                                            <GradientStop Color="#1F9E87" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#51E6CA" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="6.5" Height="6.5" Fill="#07100E"/>
                            </Grid>
                            <TextBlock Text="PulseMouse" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="9" Background="{StaticResource MintDimBrush}"
                                    BorderBrush="{StaticResource MintLine20Brush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="v0.8" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ========== body ========== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#04FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,18,12,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Padding="14" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <c:StatusDot x:Name="EngineDot" Margin="0,0,9,0"/>
                                        <ToggleButton x:Name="EnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" ToolTip="暂停 / 恢复监听" Click="EnabledSwitchClick"/>
                                        <TextBlock x:Name="EngineText" Text="监听中" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="EngineSub" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <c:TrackedText x:Name="NavLabel" Style="{StaticResource Eyebrow}" Tracking="1.26" Foreground="{StaticResource Text4Brush}" Margin="10,0,10,8" Text="控制面"/>
                                <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" c:Ui.Icon="Dashboard" Tag="Dashboard" Checked="NavChecked"/>
                                <RadioButton x:Name="NavCommands" Style="{StaticResource NavItem}" c:Ui.Icon="Commands" Tag="Commands" Checked="NavChecked"/>
                                <RadioButton x:Name="NavGestures" Style="{StaticResource NavItem}" c:Ui.Icon="Gestures" Tag="Gestures" Checked="NavChecked"/>
                                <RadioButton x:Name="NavWorkflows" Style="{StaticResource NavItem}" c:Ui.Icon="Workflows" Tag="Workflows" Checked="NavChecked"/>
                                <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="8,8,8,10"/>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" c:Ui.Icon="Settings" Tag="Settings" Checked="NavChecked"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="MainScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ContentControl x:Name="PageHost" Margin="28,22,28,32" Focusable="False">
                            <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift"/></ContentControl.RenderTransform>
                        </ContentControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========== status bar ========== -->
                <Border Grid.Row="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                    <DockPanel TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource Text3Brush}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon Kind="Check" Size="13" Margin="0,0,7,0"/>
                            <TextBlock x:Name="SavedText" VerticalAlignment="Center"/>
                            <c:Icon Kind="Shield" Size="13" Margin="18,0,7,0"/>
                            <TextBlock x:Name="OfflineText" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:StatusDot x:Name="StatusDot" Diameter="7" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
                            <c:Icon Kind="Mouse" Size="13" Margin="18,0,7,0"/>
                            <TextBlock x:Name="StatusInput" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ========== modal ========== -->
            <Grid x:Name="ModalLayer" Margin="0,44,0,0" Background="#9E040608" Visibility="Collapsed">
                <ContentControl x:Name="ModalHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
            </Grid>

            <!-- ========== toast ========== -->
            <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,44" Padding="14,8"
                    CornerRadius="10" Background="#192026" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                    Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="8"/></Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <c:Icon x:Name="ToastIcon" Kind="Check" Size="15" Foreground="{StaticResource MintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastText" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
