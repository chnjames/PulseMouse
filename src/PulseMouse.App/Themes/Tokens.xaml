<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <Color x:Key="WinColor">#0A0D10</Color>
    <SolidColorBrush x:Key="WinBrush" Color="#0A0D10"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#09FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Line3Brush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#47000000"/>
    <SolidColorBrush x:Key="Shade15Brush" Color="#26000000"/>
    <SolidColorBrush x:Key="Shade16Brush" Color="#29000000"/>
    <SolidColorBrush x:Key="Shade18Brush" Color="#2E000000"/>
    <SolidColorBrush x:Key="Shade20Brush" Color="#33000000"/>
    <SolidColorBrush x:Key="Shade22Brush" Color="#38000000"/>
    <SolidColorBrush x:Key="Shade25Brush" Color="#40000000"/>
    <SolidColorBrush x:Key="Shade30Brush" Color="#4D000000"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2F7F8"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#A9B6BA"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#6E7D82"/>
    <SolidColorBrush x:Key="Text4Brush" Color="#4C585C"/>

    <!-- Accents -->
    <Color x:Key="MintColor">#51E6CA</Color>
    <SolidColorBrush x:Key="MintBrush" Color="#51E6CA"/>
    <SolidColorBrush x:Key="MintHoverBrush" Color="#6AF0D6"/>
    <SolidColorBrush x:Key="MintDimBrush" Color="#1F51E6CA"/>
    <SolidColorBrush x:Key="MintFaintBrush" Color="#0E51E6CA"/>
    <SolidColorBrush x:Key="MintLine20Brush" Color="#3351E6CA"/>
    <SolidColorBrush x:Key="MintLine30Brush" Color="#4D51E6CA"/>
    <SolidColorBrush x:Key="MintLine35Brush" Color="#5951E6CA"/>
    <SolidColorBrush x:Key="MintLine40Brush" Color="#6651E6CA"/>
    <SolidColorBrush x:Key="MintLine45Brush" Color="#7351E6CA"/>
    <SolidColorBrush x:Key="MintLine50Brush" Color="#8051E6CA"/>
    <SolidColorBrush x:Key="MintLine60Brush" Color="#9951E6CA"/>
    <SolidColorBrush x:Key="MintHaloBrush" Color="#1A51E6CA"/>
    <SolidColorBrush x:Key="OnMintBrush" Color="#06120F"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#75B7FF"/>
    <SolidColorBrush x:Key="BlueDimBrush" Color="#1F75B7FF"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#E9C46A"/>
    <SolidColorBrush x:Key="AmberDimBrush" Color="#1FE9C46A"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#B794FF"/>
    <SolidColorBrush x:Key="VioletDimBrush" Color="#21B794FF"/>
    <SolidColorBrush x:Key="RoseBrush" Color="#F38BB5"/>
    <SolidColorBrush x:Key="RoseDimBrush" Color="#21F38BB5"/>
    <SolidColorBrush x:Key="CoralBrush" Color="#E27E68"/>
    <SolidColorBrush x:Key="CoralDimBrush" Color="#21E27E68"/>
    <SolidColorBrush x:Key="CoralLine28Brush" Color="#47E27E68"/>
    <SolidColorBrush x:Key="CoralLine30Brush" Color="#4DE27E68"/>
    <SolidColorBrush x:Key="CoralLine40Brush" Color="#66E27E68"/>
    <SolidColorBrush x:Key="DashedBrush" Color="#1FFFFFFF"/>

    <!-- Type -->
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- Radii -->
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="ChipRadius">7</CornerRadius>
</ResourceDictionary>
