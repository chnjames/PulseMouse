<UserControl x:Class="PulseMouse.App.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PulseMouse.App.Controls">
    <!--
      Sized to content; MainWindow's MainScroller owns vertical scrolling.
      Do NOT put a Stretch/fill ScrollViewer here — inside an outer ScrollViewer it gets
      infinite height, inflates blank space, and breaks scrolling after focus/click.
    -->
    <StackPanel>
        <c:PageHeader x:Name="Header">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" c:Ui.Icon="Download" Content="从模板添加" Margin="0,0,8,0" Click="TemplateClick"/>
                <Button Style="{StaticResource BtnPrimary}" c:Ui.Icon="Plus" Content="新建指令" Click="NewClick"/>
            </StackPanel>
        </c:PageHeader>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,0,0,10">
                    <ListBox x:Name="ViewSeg" DockPanel.Dock="Left" Style="{StaticResource Seg}" SelectedIndex="0" SelectionChanged="ViewChanged" Margin="0,0,10,0">
                        <ListBoxItem Content="节奏地图"/>
                        <ListBoxItem Content="列表"/>
                    </ListBox>
                    <StackPanel x:Name="MapToolbar" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="Wrap"
                                   Text="薄荷=专属 · 琥珀=替换全局 · 锁=固定"/>
                        <Button Style="{StaticResource BtnSm}" c:Ui.Icon="Plus" Content="添加程序" Click="AddAppClick"/>
                    </StackPanel>
                    <StackPanel x:Name="ListToolbar" Orientation="Horizontal" Visibility="Collapsed">
                        <ListBox x:Name="FilterSeg" Style="{StaticResource Seg}" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="FilterChanged">
                            <ListBoxItem Content="全部"/>
                            <ListBoxItem Content="应用"/>
                            <ListBoxItem Content="文件夹"/>
                            <ListBoxItem Content="网址"/>
                            <ListBoxItem Content="工作流"/>
                            <ListBoxItem Content="快捷键"/>
                            <ListBoxItem Content="重复"/>
                        </ListBox>
                        <Grid MinWidth="140" MaxWidth="220">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="32,0,10,0" c:Ui.Placeholder="搜索名称、目标或节奏" TextChanged="SearchChanged"/>
                            <c:Icon Kind="Search" Size="15" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <Border x:Name="ContextOffBanner" Style="{StaticResource Note}" Margin="0,0,0,10" Visibility="Collapsed"
                        Background="{StaticResource AmberDimBrush}" BorderBrush="{StaticResource AmberBrush}">
                    <TextBlock FontSize="12" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap"
                               Text="「按程序切换含义」已关闭：地图仍显示程序列，但执行时一律走全局。可在 设置 › 情境 中打开。"/>
                </Border>
                <Border x:Name="RecentBanner" Style="{StaticResource Note}" Margin="0,0,0,10" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="RecentAddButton" DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="添加为程序" Margin="8,0,0,0" Click="RecentAddClick"/>
                        <TextBlock x:Name="RecentBannerText" FontSize="12" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Map: horizontal scroll only when many app columns; height follows content. -->
                <ScrollViewer x:Name="MapHost" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MapRoot"/>
                </ScrollViewer>
                <StackPanel x:Name="ListHost" Visibility="Collapsed">
                    <TextBlock x:Name="ListMeta" FontSize="11.5" Foreground="{StaticResource Text3Brush}" Margin="2,0,2,10"/>
                    <ListBox x:Name="List" Style="{StaticResource CardList}" SelectionChanged="ListSelectionChanged"/>
                    <Grid x:Name="EmptyState" Visibility="Collapsed" Margin="0,8,0,0">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource Line2Brush}" StrokeDashArray="3.5 3"/>
                        <TextBlock Text="没有符合条件的指令" FontSize="12.5" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center" Margin="18,34"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                    <Border Padding="18,16,18,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <c:KindChip x:Name="InspectorChip" DockPanel.Dock="Right" VerticalAlignment="Top"/>
                            <StackPanel>
                                <c:TrackedText x:Name="InspectorEyebrow" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="InspectorTitle" Style="{StaticResource H3}"/>
                                <TextBlock x:Name="InspectorBadge" FontSize="11.5" Foreground="{StaticResource Text3Brush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="18,16,18,2">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="名称"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource Input}" c:Ui.Placeholder="例如：打开 VS Code"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="在哪里生效"/>
                            <ListBox x:Name="ScopeSeg" Style="{StaticResource SegFull}" SelectionChanged="ScopeChanged">
                                <ListBoxItem Content="全局"/>
                                <ListBoxItem Content="指定程序"/>
                            </ListBox>
                            <DockPanel x:Name="ScopeAppPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSm}" Content="拾取" Margin="8,0,0,0" Click="PickScopeClick" ToolTip="3 秒内把光标移到目标窗口"/>
                                <TextBox x:Name="ScopeAppBox" Style="{StaticResource Input}" c:Ui.Placeholder="chrome"/>
                            </DockPanel>
                            <TextBlock x:Name="ScopeHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock x:Name="PatternLength" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="节奏" Margin="0"/>
                            </DockPanel>
                            <c:PatternComposer x:Name="Composer"/>
                            <TextBlock x:Name="PatternHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="SuggestPanel" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="动作类型"/>
                            <ListBox x:Name="KindSeg" Style="{StaticResource SegFull}" SelectionChanged="KindChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Content="应用"/>
                                <ListBoxItem Content="文件夹"/>
                                <ListBoxItem Content="网址"/>
                                <ListBoxItem Content="工作流"/>
                                <ListBoxItem Content="快捷键"/>
                                <ListBoxItem Content="重复"/>
                            </ListBox>
                        </StackPanel>
                        <StackPanel x:Name="TargetPanel" Margin="0,0,0,15">
                            <TextBlock x:Name="TargetLabel" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="浏览…" Margin="8,0,0,0" Click="BrowseClick"/>
                                <TextBox x:Name="TargetBox" Style="{StaticResource InputMono}" PreviewKeyDown="TargetKeyDown"/>
                            </DockPanel>
                            <TextBlock x:Name="TargetHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="ShortcutPresets" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border x:Name="RepeatNote" Style="{StaticResource Note}" Margin="0,0,0,15" Visibility="Collapsed">
                            <TextBlock x:Name="RepeatNoteText" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                        <Border x:Name="WorkflowNote" Style="{StaticResource Note}" Margin="0,0,0,15" Visibility="Collapsed">
                            <DockPanel>
                                <c:Icon Kind="Workflow" Size="15" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="WorkflowNoteText" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" LineHeight="18"/>
                                    <Button x:Name="WorkflowNoteButton" Style="{StaticResource BtnSm}" c:Ui.Icon="External" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ToWorkflowsClick"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="PinPanel" Style="{StaticResource Note}" Margin="0,0,0,15" Visibility="Collapsed">
                            <DockPanel>
                                <ToggleButton x:Name="PinSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="12,0,0,0" Click="PinClick"/>
                                <StackPanel>
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="固定：在所有程序中保持不变" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="PinHint" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="HeatPanel" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="最近 7 天"/>
                            <DockPanel>
                                <TextBlock x:Name="HeatTotal" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                <StackPanel x:Name="HeatBars" Orientation="Horizontal" Height="28"/>
                            </DockPanel>
                            <TextBlock x:Name="LastUsedText" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Padding="18,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource Shade16Brush}" CornerRadius="0,0,13,13">
                        <DockPanel>
                            <Button x:Name="DeleteButton" Style="{StaticResource BtnDanger}" c:Ui.Icon="Trash" c:Ui.IconSize="14" Content="删除" Click="DeleteClick"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TestButton" Style="{StaticResource Btn}" c:Ui.Icon="Play" c:Ui.IconSize="14" Content="测试" Margin="0,0,8,0" Click="TestClick"/>
                                <Button x:Name="SaveButton" Style="{StaticResource BtnPrimary}" Content="保存" Click="SaveClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>
        </Grid>
    </StackPanel>
</UserControl>
