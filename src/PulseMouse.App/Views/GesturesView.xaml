<UserControl x:Class="PulseMouse.App.Views.GesturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PulseMouse.App.Controls">
    <StackPanel>
        <c:PageHeader x:Name="Header">
            <Border Height="34" Padding="12,0,6,0" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line2Brush}" Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="启用方向手势" FontSize="12.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="EnabledSwitch" Style="{StaticResource Switch}" Click="EnabledClick"/>
                </StackPanel>
            </Border>
        </c:PageHeader>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <ContentControl Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <c:KindChip x:Name="BoundChip" DockPanel.Dock="Right" Kind="Muted" VerticalAlignment="Top"/>
                        <StackPanel>
                            <c:TrackedText Style="{StaticResource Eyebrow}" Text="DIRECTION PAD"/>
                            <TextBlock Style="{StaticResource H3}" Text="方向面板"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid x:Name="Pad" HorizontalAlignment="Center" Margin="0,6,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="92"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="92"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="92"/>
                        </Grid.RowDefinitions>
                        <RadioButton x:Name="TileUp" Grid.Row="0" Grid.Column="2" Style="{StaticResource DirTile}" Tag="Up" Checked="TileChecked"/>
                        <RadioButton x:Name="TileLeft" Grid.Row="2" Grid.Column="0" Style="{StaticResource DirTile}" Tag="Left" Checked="TileChecked"/>
                        <RadioButton x:Name="TileRight" Grid.Row="2" Grid.Column="4" Style="{StaticResource DirTile}" Tag="Right" Checked="TileChecked"/>
                        <RadioButton x:Name="TileDown" Grid.Row="4" Grid.Column="2" Style="{StaticResource DirTile}" Tag="Down" Checked="TileChecked"/>
                        <Grid Grid.Row="2" Grid.Column="2" Width="76" Height="76">
                            <Ellipse Stroke="{StaticResource Line2Brush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#1A51E6CA" Offset="0"/>
                                        <GradientStop Color="#0051E6CA" Offset="0.7"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <c:Icon Kind="Mouse" Size="20" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="按住中键" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Border Style="{StaticResource SRowLast}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Slider x:Name="DistanceSlider" Style="{StaticResource Range}" Minimum="25" Maximum="500" TickFrequency="5" ValueChanged="DistanceChanged"/>
                                <TextBlock x:Name="DistanceText" Style="{StaticResource Val}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="最小移动距离"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="移动距离小于此值时不触发手势，避免与中键点击冲突"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Note}" Margin="0,4,0,0">
                        <DockPanel>
                            <c:Icon Kind="Info" Size="14" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" LineHeight="18"
                                       Text="中键原始事件仍会透传给当前应用。若浏览器出现自动滚动，可把手势距离调大，或在「输入方式」中改用侧键。"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,16,18,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <c:KindChip x:Name="InspectorChip" DockPanel.Dock="Right" VerticalAlignment="Top"/>
                            <StackPanel>
                                <c:TrackedText x:Name="InspectorEyebrow" Style="{StaticResource Eyebrow}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <c:Icon x:Name="InspectorIcon" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="InspectorTitle" Style="{StaticResource H3}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource Shade16Brush}" CornerRadius="0,0,13,13">
                        <DockPanel>
                            <Button x:Name="ClearButton" Style="{StaticResource BtnDanger}" c:Ui.Icon="Trash" c:Ui.IconSize="14" Content="清除绑定" Click="ClearClick"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TestButton" Style="{StaticResource Btn}" c:Ui.Icon="Play" c:Ui.IconSize="14" Content="测试" Margin="0,0,8,0" Click="TestClick"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="保存" Click="SaveClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="18,16,18,2">
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="名称"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource Input}" c:Ui.Placeholder="例如：打开下载目录"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="动作类型"/>
                            <ListBox x:Name="KindSeg" Style="{StaticResource SegFull}" SelectionChanged="KindChanged">
                                <ListBoxItem c:Ui.Icon="App" Content="应用"/>
                                <ListBoxItem c:Ui.Icon="Folder" Content="文件夹"/>
                                <ListBoxItem c:Ui.Icon="Url" Content="网址"/>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock x:Name="TargetLabel" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="浏览…" Margin="8,0,0,0" Click="BrowseClick"/>
                                <TextBox x:Name="TargetBox" Style="{StaticResource InputMono}"/>
                            </DockPanel>
                            <TextBlock x:Name="TargetHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </Grid>
    </StackPanel>
</UserControl>
