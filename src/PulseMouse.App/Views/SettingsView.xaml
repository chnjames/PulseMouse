<UserControl x:Class="PulseMouse.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PulseMouse.App.Controls">
    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <c:PageHeader x:Name="Header">
            <Button Style="{StaticResource Btn}" c:Ui.Icon="Folder" Content="打开配置文件夹" Click="OpenConfigClick"/>
        </c:PageHeader>

        <StackPanel MaxWidth="840" HorizontalAlignment="Left" Width="840">
            <!-- general -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="通用" Margin="2,0,2,8"/>
            <ContentControl Style="{StaticResource Card}" Padding="18,2" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,0,0,0" Click="StartupClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="开机自启动"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="Windows 登录后自动运行 PulseMouse（写入当前用户启动项，无需管理员权限）"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <ToggleButton x:Name="SoundSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,0,0,0" Click="ToggleClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="执行成功提示音"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="指令成功发起后播放系统轻提示音"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRowLast}">
                        <DockPanel>
                            <ListBox x:Name="LanguageSeg" DockPanel.Dock="Right" Style="{StaticResource Seg}" Margin="20,0,0,0" SelectionChanged="LanguageChanged">
                                <ListBoxItem Content="中文"/>
                                <ListBoxItem Content="English"/>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="语言 / Language"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="切换导航、页面标题与状态栏"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- timing -->
            <DockPanel Margin="2,0,2,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmGhost}" c:Ui.Icon="Refresh" c:Ui.IconSize="13" Content="恢复默认" Click="ResetTimingClick"/>
                <TextBlock Style="{StaticResource GroupTitle}" Text="节奏识别"/>
            </DockPanel>
            <ContentControl Style="{StaticResource Card}" Padding="18,2" Margin="0,0,0,20">
                <StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,16">
                        <c:TimingRuler x:Name="Ruler"/>
                    </Border>
                    <StackPanel x:Name="TimingRows"/>
                </StackPanel>
            </ContentControl>

            <!-- capsule -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="Pulse Capsule · 屏幕状态胶囊" Margin="2,0,2,8"/>
            <ContentControl Style="{StaticResource Card}" Padding="18,2" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <ToggleButton x:Name="CapsuleSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,0,0,0" Click="ToggleClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="启用状态胶囊"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="在鼠标所在屏幕的任务栏上方显示识别状态，不抢焦点、可点击穿透"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
                                <RadioButton x:Name="PosLeft" Style="{StaticResource PosButton}" Content="左下" Tag="Left" Padding="5,0,0,4" HorizontalContentAlignment="Left" Checked="PositionChecked"/>
                                <RadioButton x:Name="PosCenter" Style="{StaticResource PosButton}" Content="底部居中" Tag="Center" Padding="0,0,0,4" HorizontalContentAlignment="Center" Checked="PositionChecked"/>
                                <RadioButton x:Name="PosRight" Style="{StaticResource PosButton}" Content="右下" Tag="Right" Padding="0,0,5,4" HorizontalContentAlignment="Right" Margin="0" Checked="PositionChecked"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="胶囊位置"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="选择状态胶囊的停靠位置"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <ToggleButton x:Name="BreathingSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,0,0,0" Click="ToggleClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="呼吸动画"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="激活与输入期间使用缓慢呼吸反馈"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRowLast}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" c:Ui.Icon="Play" c:Ui.IconSize="14" Content="预览胶囊" Margin="20,0,0,0" Click="PreviewClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="预览"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="在屏幕上显示一次「已匹配」状态"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- safety & data -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="安全与数据" Margin="2,0,2,8"/>
            <ContentControl Style="{StaticResource Card}" Padding="18,2" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource SRow}">
                        <DockPanel>
                            <ToggleButton x:Name="ConfirmSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="20,0,0,0" Click="ToggleClick"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="工作流执行前确认"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="运行多步骤动作前显示确认对话框"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SRowLast}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
                                <Button Style="{StaticResource Btn}" c:Ui.Icon="Download" c:Ui.IconSize="14" Content="导出" Margin="0,0,10,0" Click="ExportClick"/>
                                <Button Style="{StaticResource Btn}" c:Ui.Icon="Upload" c:Ui.IconSize="14" Content="导入" Click="ImportClick"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowName}" Text="配置备份"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="导出或恢复指令、手势与偏好（JSON，含版本号）"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- AI -->
            <TextBlock Style="{StaticResource GroupTitle}" Text="AI 入口 · 可选" Margin="2,0,2,8"/>
            <ContentControl Style="{StaticResource Card}" Padding="18,2" Margin="0,0,0,20">
                <Border Style="{StaticResource SRowLast}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBox x:Name="AiUrlBox" Style="{StaticResource InputMono}" Width="260" Margin="0,0,10,0" TextChanged="AiUrlChanged"/>
                            <Button Style="{StaticResource Btn}" c:Ui.Icon="External" c:Ui.IconSize="14" Content="打开" Click="OpenAiClick"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowName}" Text="AI 网页地址"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="只打开指定的 HTTPS 页面，不读取或上传屏幕内容"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ContentControl>
        </StackPanel>
    </StackPanel>
</UserControl>
