<UserControl x:Class="PulseMouse.App.Views.WorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PulseMouse.App.Controls">
    <StackPanel>
        <c:PageHeader x:Name="Header">
            <Button Style="{StaticResource BtnPrimary}" c:Ui.Icon="Plus" Content="新建工作流" Click="NewClick"/>
        </c:PageHeader>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <ListBox x:Name="List" Style="{StaticResource CardList}" SelectionChanged="ListSelectionChanged"/>
                <Grid x:Name="EmptyState" Visibility="Collapsed" Margin="0,0,0,8">
                    <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource Line2Brush}" StrokeDashArray="3.5 3"/>
                    <TextBlock Text="还没有工作流" FontSize="12.5" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Center" Margin="18,34"/>
                </Grid>
                <Border Style="{StaticResource Note}" Margin="0,4,0,0">
                    <DockPanel>
                        <c:Icon Kind="Shield" Size="14" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                        <TextBlock x:Name="SafetyText" FontSize="11.5" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" LineHeight="18"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <ContentControl Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,16,18,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <c:KindChip x:Name="SummaryChip" DockPanel.Dock="Right" Kind="Workflow" VerticalAlignment="Top"/>
                            <StackPanel>
                                <c:TrackedText x:Name="InspectorEyebrow" Style="{StaticResource Eyebrow}"/>
                                <TextBlock x:Name="InspectorTitle" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Background="{StaticResource Shade16Brush}" CornerRadius="0,0,13,13">
                        <DockPanel>
                            <Button x:Name="DeleteButton" Style="{StaticResource BtnDanger}" c:Ui.Icon="Trash" c:Ui.IconSize="14" Content="删除" Click="DeleteClick"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Btn}" c:Ui.Icon="Copy" c:Ui.IconSize="14" Content="复制 JSON" Margin="0,0,8,0" Click="CopyJsonClick"/>
                                <Button x:Name="TestButton" Style="{StaticResource Btn}" c:Ui.Icon="Play" c:Ui.IconSize="14" Content="测试运行" Margin="0,0,8,0" Click="TestClick"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="保存" Click="SaveClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="18,16,18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,0,15" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="名称"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource Input}" c:Ui.Placeholder="例如：晨间工作流"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,15" VerticalAlignment="Top">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock x:Name="PatternLength" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="节奏" Margin="0"/>
                                </DockPanel>
                                <c:PatternComposer x:Name="Composer"/>
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,4,0,9">
                            <Button x:Name="AddStepButton" DockPanel.Dock="Right" Style="{StaticResource BtnSm}" c:Ui.Icon="Plus" Content="添加步骤" Click="AddStepClick"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="步骤" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Text2Brush}"/>
                                <TextBlock x:Name="StepCount" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="StepsPanel"/>
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </Grid>
    </StackPanel>
</UserControl>
